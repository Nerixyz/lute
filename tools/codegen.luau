--!strict

local fs = require("@lute/fs")
local process = require("@lute/process")
local path = require("@std/path")

local cli = require("@batteries/cli")

local TYPEDEF_PATTERN = "return {%*}"
local DICTIONARY_PATTERN = '["%*"] = [==[%*]==],'

local args = cli.parser()

args:add("codegen", "positional", { help = "This script", required = true })

args:add("help", "flag", { help = "Show this message" })
args:add("kind", "positional", { help = "The kind of code to generate (embed-files, merge-types)" })
args:add("out", "option", { help = "A path to the generated directory or file" })
args:add("prefix", "option", { help = "A path to the generated directory or file" })
args:add("cxxname", "option", { help = "Name of the C++ static that's created" })

args:parse({ ... })

if args:has("help") then
	args:help()
	return
end

local kind = args:get("kind")
local outpath = args:get("out")
local prefix = args:get("prefix")
local cxxname = args:get("cxxname")
local forwarded = args:forwarded() :: { string }

assert(type(kind) == "string", "Missing --kind")
assert(type(outpath) == "string", "Missing --out")

local function writeLines(file, lines: { string })
	fs.write(file, table.concat(lines, "\n") .. "\n")
end

local function filename(path: string)
	return string.match(path, "([^\\/]+)$")
end

local function embedFiles()
	assert(type(cxxname) == "string")
	assert(type(prefix) == "string")

	local cpp = fs.open(`{outpath}.cpp`, "w+")

	local incHeaderName = filename(outpath)
	writeLines(cpp, {
		"// This file is auto-generated by codegen.luau. Do not edit.",
		"",
		`#include "{incHeaderName}.h"`,
		"",
		`constexpr std::pair<std::string_view, std::string_view> {cxxname}[] = \{`,
	})

	local seenDirs: { string } = {}

	local numItems = 0
	for _, fwPath in forwarded do
		local d = path.dirname(fwPath)
		if #d > 0 and d ~= "." then
			local subdir = ""
			local parsed = path.parse(d)
			for _, part in parsed.parts do
				subdir = subdir .. (if #subdir == 0 then "" else "/") .. part
				if table.find(seenDirs, subdir) == nil then
					table.insert(seenDirs, subdir)
					fs.write(cpp, `\n    \{"{prefix .. subdir}", "#directory"},\n`)
					numItems += 1
				end
			end
		end

		local aliasedPath = prefix .. fwPath

		local src = fs.readfiletostring(fwPath)
		if #src > 16_000 then
			-- https://learn.microsoft.com/en-us/cpp/error-messages/compiler-errors-1/compiler-error-c2026
			-- MSVC can't handle a single string literal being over 16380 single-byte characters,
			-- but can if they are adjacent concatenated strings. So, we split the string line-by-line into
			-- adjacent substrings.
			local lines = string.split(src, "\n")
			local generatedLines = table.create(#lines)
			for _, line in lines do
				local escapedLine = string.gsub(line, "\\", "\\\\")
				escapedLine = string.gsub(escapedLine, "\r", "")
				escapedLine = string.gsub(escapedLine, '"', '\\"')
				table.insert(generatedLines, `"{escapedLine}\\n"`)
			end
			fs.write(cpp, `\n    \{"{aliasedPath}", {table.concat(generatedLines, "\n")}},\n`)
		else
			fs.write(cpp, `\n    \{"{aliasedPath}", R"LUTE_CMD({src})LUTE_CMD"},\n`)
		end
		numItems += 1
	end

	fs.write(cpp, "};\n")
	fs.close(cpp)

	local header = fs.open(`{outpath}.h`, "w+")
	writeLines(header, {
		"// This file is auto-generated by codegen.luau. Do not edit.",
		"#pragma once",
		"",
		"#include <string_view>",
		"#include <utility>",
		"",
		`extern const std::pair<std::string_view, std::string_view> {cxxname}[{numItems}];`,
	})
	fs.close(header)
end

local function splitOnce(haystack: string, needle: string): string
	local a, b = string.find(haystack, needle)
	assert(a ~= nil and b ~= nil)
	return string.sub(haystack, 1, a - 1), string.sub(haystack, b + 1)
end

local function toRelPath(path: string, prefix: string): string
	assert(string.sub(path, 1, #prefix) == prefix)
	path = string.sub(path, #prefix + 1)
	path = string.gsub(path, "\\", "/")
	path = string.gsub(path, "^/+", "")
	return path
end

local function mergeTypes()
	local dictionaryEntries: { { string } } = {}
	local prefix = nil
	local dir = nil
	for _, fwPath in forwarded do
		-- @std=<dir>
		if string.sub(fwPath, 1, 1) == "@" then
			prefix, dir = splitOnce(string.sub(fwPath, 2), "=")
			continue
		end
		assert(prefix ~= nil and dir ~= nil)

		local content = fs.readasync(fwPath)
		local relPath = toRelPath(fwPath, dir)

		table.insert(dictionaryEntries, { `{prefix}/{relPath}`, content })
	end

	-- sort entries for reproducibility
	table.sort(dictionaryEntries, function(lhs, rhs): boolean
		return lhs[1] < rhs[1]
	end)

	local stringDictionary = ""
	for _, value in dictionaryEntries do
		stringDictionary ..= string.format(DICTIONARY_PATTERN, value[1], value[2])
	end

	fs.writestringtofile(outpath, string.format(TYPEDEF_PATTERN, stringDictionary))
end

if kind == "embed-files" then
	embedFiles()
elseif kind == "merge-types" then
	mergeTypes()
else
	print(`Unknown kind: '{kind}'`)
	process.exit(1)
end
